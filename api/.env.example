# Local development defaults. Copy to api/.env and adjust.
# Postgres + pgvector (docker compose up db):
DATABASE_URL=postgresql+psycopg://alexandria:alexandria@localhost:5432/alexandria
# ...or zero-setup SQLite (similar-books falls back to in-memory search):
# DATABASE_URL=sqlite:///./alexandria-dev.db

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Comma-separated (or a JSON list)
CORS_ORIGINS=http://localhost:3000

# Optional: enables the conversational onboarding librarian.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low

# Chat spend guards (each turn = one paid LLM call)
CHAT_LIMIT_USER_PER_HOUR=20
CHAT_LIMIT_USER_PER_DAY=60
CHAT_LIMIT_IP_PER_HOUR=40
CHAT_LIMIT_GLOBAL_PER_DAY=300
